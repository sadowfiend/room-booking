# Redis (Upstash). Нужна любая одна пара. Без неё сервер использует in-memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Или имена от Vercel Marketplace:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Показать переключатель симуляции 409 (инструмент разработчика)
MOCK_ALLOW_FORCED_CONFLICT=1
NEXT_PUBLIC_DEV_TOOLS=1